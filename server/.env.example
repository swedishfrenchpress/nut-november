PORT=3001
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
MAX_PENDING_DONATIONS=1000
# Set a persistent 64-byte seed (128 hex characters). Never commit a real seed.
COCO_SEED_HEX=
# Enable private wallet commands with a separate random operator credential.
# Unset/empty disables the listener. Bind address is always 127.0.0.1.
WALLET_ADMIN_TOKEN=
WALLET_ADMIN_PORT=3002
