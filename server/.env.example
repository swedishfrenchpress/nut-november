PORT=3001
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
MAX_PENDING_DONATIONS=1000
# Set a persistent 64-byte seed (128 hex characters). Never commit a real seed.
COCO_SEED_HEX=
# Optional: defaults to DATA_DIR/wallet-admin.sock. The socket's directory must
# be owned by the API user with mode 0700; the socket is created with mode 0600.
# WALLET_SOCKET_PATH=/data/wallet-admin.sock
